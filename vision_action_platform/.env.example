# 복사해서 .env 로 쓰기:  cp .env.example .env
# .env 는 Git 에 올리지 않는다 (.gitignore)

# Django — 실제 값은 직접 만든 긴 무작위 문자열로 바꾼다
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100

# PostgreSQL
POSTGRES_DB=vision_action
POSTGRES_USER=vision_action
POSTGRES_PASSWORD=change-me

# IP Webcam — 허용할 카메라만 "이름=주소" 로, 여러 개는 쉼표로. 화면에는 이름만 보인다
#   휴대폰 IP Webcam 앱의 영상 주소는 보통 http://<휴대폰 IP>:8080/video
IPWEBCAM_CAMERAS=phone=http://192.168.0.10:8080/video
CAPTURE_SECONDS=8

MAX_UPLOAD_MB=100
